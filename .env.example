# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Prefer read-only / view-only API keys wherever the exchange offers them.

EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Database connection. For a SQLite start, a path is enough:
#   DATABASE_URL=sqlite:///data/foresight.db
# For Postgres/TimescaleDB:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/foresight
DATABASE_URL=

# Where raw/interim/processed data lives. Leave unset to use ForeSight/data/,
# but note that path is inside the Google-Drive-synced sandbox: git ignores
# data/, and Drive does not care. Point this somewhere off-Drive before
# fetching the full archive (~4.7M bars).
#   FORESIGHT_DATA_ROOT=C:/ForeSightData
FORESIGHT_DATA_ROOT=
